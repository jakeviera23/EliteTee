{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "env": {
        "EXPO_NO_DOTENV": "1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6812534625",
        "appleTeamId": "GJD4HBZ7D7"
      }
    }
  }
}
