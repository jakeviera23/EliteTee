{
  "name": "elitetee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync-images": "node scripts/sync-images.mjs",
    "fetch-images": "node scripts/fetch-images.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:supabase": "node scripts/test-supabase-connection.mjs",
    "import:golf-courses": "node --experimental-strip-types scripts/import-golf-courses.mjs",
    "import:curated-golf-courses": "npx tsx scripts/import-curated-golf-courses.mjs",
    "audit:curated-courses": "node scripts/seed/curated/audit-course-metadata.mjs",
    "enrich:curated-courses": "node scripts/seed/curated/apply-verified-enrichments.mjs",
    "update:golf-course-image": "node scripts/update-golf-course-image.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.4.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  }
}
